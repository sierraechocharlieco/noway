{
  "manifest_version": 3,
  "name": "No Way!",
  "version": "1.0.0",
  "description": "Prevents accidental interactions on social media sites during OSINT investigations.",
  "homepage_url": "https://github.com/sierraechocharlieco/noway",
  "icons": {
    "16": "icons/no-way-icon-16.png",
    "48": "icons/no-way-icon-48.png",
    "128": "icons/no-way-icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/no-way-icon-16.png",
      "48": "icons/no-way-icon-48.png"
    },
    "default_title": "No Way!"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "options_page": "options/rules.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "ai/sidepanel.html"
  },
  "web_accessible_resources": [{
    "resources": ["shared/auto.js", "assets/fonts/hanken-grotesk.woff2", "assets/fonts/schibsted-grotesk.woff2", "assets/betta-mark.png"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
